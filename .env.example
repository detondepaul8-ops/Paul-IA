# ══════════════════════════════════════════════════════════════
# Paul IA — Environment Variables
# ══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Project URL (ex: https://votre-projet.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role (secret) key — SERVER ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Database (Prisma → Supabase PostgreSQL) ───────────────────
# Connection string for Prisma (uses connection pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?pgbouncer=true&connect_timeout=15

# Direct connection (for migrations)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?connect_timeout=15