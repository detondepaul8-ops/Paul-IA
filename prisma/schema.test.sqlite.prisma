generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = "file:/tmp/paul-test.db"
}

// ── Paul IA Models ──────────────────────────────────────────────────
// All models use "paul_" prefix to coexist with Factory IA tables.

model paul_Conversation {
  id        String   @id @default(cuid())
  title     String   @default("Nouvelle conversation")
  module    String   @default("chat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  messages  paul_Message[]

  @@map("paul_conversations")
}

model paul_Message {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  role           String
  content        String
  module         String?
  mediaUrl       String?             @map("media_url")
  mediaType      String?             @map("media_type")
  mediaFilename  String?             @map("media_filename")
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   paul_Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("paul_messages")
}

// Media storage (database backend). Used when no Supabase Storage API key
// is configured; files are served by the /api/media/[filename] route.
model paul_MediaFile {
  id        String   @id
  mediaType String   @map("media_type")
  mimeType  String   @map("mime_type")
  filename  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("paul_media_files")
}

// Fichiers Excel/PDF générés par l'IA : spec stocké, octets régénérés au
// téléchargement par la route /api/files (exceljs / pdf-lib).
model paul_AiFile {
  id        String   @id
  kind      String
  title     String
  filename  String
  spec      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("paul_ai_files")
}

// ── PAUL IA MONITOR : tâches longues + suivi temps réel ────────────────
// Tâche complexe : plan annoncé, étapes réelles, agents mobilisés,
// compte rendu final. Les détails fournisseurs restent côté admin.
model paul_Task {
  id              String    @id @default(cuid())
  conversationId  String?   @map("conversation_id")
  module          String    @default("agents")
  title           String
  request         String
  status          String    @default("pending") // pending | running | succeeded | partial | failed
  progress        Int       @default(0) // pourcentage réellement calculé
  plan            Json      @default("[]") // étapes annoncées au client
  result          String?
  summary         String? // compte rendu final automatique
  providerDetails Json? // RÉSERVÉ ADMIN : fournisseurs, modèles, durées, erreurs
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  durationMs      Int?      @map("duration_ms")
  createdAt       DateTime  @default(now()) @map("created_at")
  events          paul_Event[]

  @@index([status])
  @@index([createdAt])
  @@map("paul_tasks")
}

// Événement réel d'exécution : publié à chaque changement d'étape.
model paul_Event {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  step      String // identifiant d'étape du plan
  label     String
  status    String   @default("done") // pending | running | done | failed | warning
  detail    String?
  agentName String?  @map("agent_name") // "Agent parallèle 1", "Agent de vérification"
  createdAt DateTime @default(now()) @map("created_at")
  task      paul_Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("paul_events")
}