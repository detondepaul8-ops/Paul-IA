generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Paul IA Models ──────────────────────────────────────────────────
// All models use "paul_" prefix to coexist with Factory IA tables.

model paul_Conversation {
  id        String   @id @default(cuid())
  title     String   @default("Nouvelle conversation")
  module    String   @default("chat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  messages  paul_Message[]

  @@map("paul_conversations")
}

model paul_Message {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  role           String
  content        String              @db.Text
  module         String?
  mediaUrl       String?             @map("media_url") @db.Text
  mediaType      String?             @map("media_type")
  mediaFilename  String?             @map("media_filename") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   paul_Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("paul_messages")
}

// Media storage (database backend). Used when no Supabase Storage API key
// is configured; files are served by the /api/media/[filename] route.
model paul_MediaFile {
  id        String   @id
  mediaType String   @map("media_type")
  mimeType  String   @map("mime_type")
  filename  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("paul_media_files")
}